# Kopieer naar .env en vul in. De app werkt ook zonder.

# TMDB (gratis account op themoviedb.org, Instellingen > API): posters, trailers, land, cast, IMDb-nummer.
# De korte "API Key" of het lange "API Read Access Token" werken allebei.
# Let op: gratis sleutel is voor niet-commercieel gebruik.
TMDB_API_KEY=

# OMDb (gratis sleutel op omdbapi.com): voegt IMDb-score, jaartal en directe IMDb/Letterboxd-links toe
OMDB_API_KEY=

# Claude (console.anthropic.com, betaald per gebruik): schrijft per film een korte sfeertekst en
# kiest drie titels voor "Voor liefhebbers van". Elke film één keer; daarna uit de cache.
ANTHROPIC_API_KEY=
